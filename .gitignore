node_modules/
dist/
*.tsbuildinfo
*.log

# Engines and fonts are fetched by `pnpm fetch:engines`, never committed
public/engines/
public/fonts/

# Playwright output
playwright-report/
test-results/

# Local-only test documents (the OCR specs skip without them; see e2e/ocr.spec.ts)
e2e/fixtures/local/

# Keys and environment files must never be committed
.env*
*.pem
*.key
*.p12
*.pfx

{
  // Deployment for the browser build: a Worker that serves the assembled
  // `dist/` as static assets. No API, no database, no Functions, no SSR — the request
  // path never runs JavaScript on Cloudflare, it only hands back files.
  //
  // `tools/assemble-dist.mjs` produces exactly what is uploaded: the landing at `/`,
  // the editor at `/editor/`, the legal pages, `404.html`, `en/404.html` and the pinned engines.
  // `dist/_headers` travels with it, so the CSP and the COOP/COEP pair for `/editor/*`
  // are enforced by the host and never depend on a dashboard setting.
  //
  // GitHub Actions is the only thing that deploys: the `deploy` job of `.github/workflows/ci.yml`
  // publishes the `dist/` that its `verify` job assembled, once every check has passed.
  // `pnpm worker:deploy` is the same publish by hand. The Workers Builds integration of the
  // Cloudflare dashboard must not deploy this Worker on a push: a second deploy path would
  // publish builds the checks never saw. The `routes` entry below claims `pdf.isolmaz.com` for
  // **this** Worker only.
  "name": "pdf-editor",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    // `/gizlilik` and `/kosullar` are written as `.html` files and must resolve without
    // the extension; an unknown path gets the nearest `404.html`: the English one under
    // `/en/`, the Turkish one everywhere else.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      // The published surface. Remove this block to deploy without touching DNS
      // and attach the domain from the dashboard instead.
      "pattern": "pdf.isolmaz.com",
      "custom_domain": true
    }
  ],
  "observability": { "enabled": false }
}

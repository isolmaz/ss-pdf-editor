{
  "name": "pdf-editor",
  "version": "0.0.0",
  "private": true,
  "description": "SsPdfEditor: a browser-based, fully local PDF editor",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "node tools/hooks/install.mjs",
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter site build && pnpm --filter web build",
    "preview": "node tools/preview-dist.mjs",
    "typecheck": "tsc -b",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:docs": "node tools/audit/docs-sync.mjs",
    "unit": "vitest run --passWithNoTests --reporter=default --reporter=json --outputFile.json=node_modules/.vitest-report.json && node tools/audit/require-tests.mjs && node tools/audit/regressions.cjs",
    "coverage": "node tools/coverage/report.mjs",
    "measure:model": "vitest run --config vitest.measure.config.ts",
    "e2e": "playwright test",
    "fidelity": "node tools/fidelity/run.mjs",
    "fetch:engines": "node tools/fetch-engines.mjs",
    "verify:assets": "node tools/verify-assets.mjs",
    "check:budgets": "node tools/check-build-budgets.mjs",
    "check:licenses": "node tools/check-licenses.mjs",
    "assemble:dist": "node tools/assemble-dist.mjs",
    "audit:regressions": "node tools/audit/regressions.cjs",
    "audit:model-types": "node tools/audit/typecheck-model.cjs",
    "ci:behavior": "node tools/behavior/editor-flow-check.mjs && node tools/behavior/text-edit-check.mjs && tsx tools/behavior/sign-check.mts",
    "ci:verify": "pnpm install --frozen-lockfile && pnpm typecheck && pnpm check && pnpm check:docs && pnpm fetch:engines --sync && pnpm unit && pnpm audit:model-types && pnpm build && pnpm check:budgets && pnpm verify:assets && pnpm check:licenses && pnpm assemble:dist",
    "ci:full": "pnpm ci:verify && pnpm ci:behavior",
    "worker:deploy": "pnpm run assemble:dist && npx --yes wrangler@4.135.0 deploy",
    "worker:deploy:dry": "pnpm run assemble:dist && npx --yes wrangler@4.135.0 deploy --dry-run"
  },
  "devDependencies": {
    "@bcoe/v8-coverage": "1.0.2",
    "@bentopdf/gs-wasm": "0.1.1",
    "@biomejs/biome": "2.5.13",
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/merriweather": "0.4.2",
    "@expo-google-fonts/montserrat": "0.4.2",
    "@expo-google-fonts/noto-sans": "0.4.2",
    "@expo-google-fonts/noto-serif": "0.4.2",
    "@expo-google-fonts/open-sans": "0.4.2",
    "@expo-google-fonts/poppins": "0.4.1",
    "@expo-google-fonts/roboto": "0.4.3",
    "@expo-google-fonts/roboto-mono": "0.4.2",
    "@expo-google-fonts/source-sans-3": "0.4.2",
    "@tesseract.js-data/ara": "1.0.0",
    "@tesseract.js-data/aze": "1.0.0",
    "@tesseract.js-data/bul": "1.0.0",
    "@tesseract.js-data/ces": "1.0.0",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/chi_tra": "1.0.0",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/ell": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fas": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@tesseract.js-data/heb": "1.0.0",
    "@tesseract.js-data/hin": "1.0.0",
    "@tesseract.js-data/hun": "1.0.0",
    "@tesseract.js-data/ita": "1.0.0",
    "@tesseract.js-data/jpn": "1.0.0",
    "@tesseract.js-data/kmr": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "@tesseract.js-data/nld": "1.0.0",
    "@tesseract.js-data/pol": "1.0.0",
    "@tesseract.js-data/por": "1.0.0",
    "@tesseract.js-data/ron": "1.0.0",
    "@tesseract.js-data/rus": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "@tesseract.js-data/swe": "1.0.0",
    "@tesseract.js-data/tur": "1.0.0",
    "@tesseract.js-data/ukr": "1.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "asn1js": "3",
    "ast-v8-to-istanbul": "1.0.7",
    "axe-core": "^4.13.0",
    "happy-dom": "^20.14.6",
    "monocart-coverage-reports": "2.13.2",
    "pkijs": "3",
    "playwright": "^1.63.0",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.1.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "author": "isolmaz <info@isolmaz.com>"
}
